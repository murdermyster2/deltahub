-- ⚠️ ТЕСТОВЫЙ АВТО-ФАРМ "ПОД КАРТОЙ" (Высокий риск!)
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer
local isFarming = false
local farmThread = nil

-- Настройки
local COIN_GOAL = 10 -- Максимум за раунд (без Elite)
local UNDERMAP_OFFSET = 500 -- Насколько глубоко под карту прячемся (studs)

-- Функция для получения монет
local function getCurrentCoins()
    local leaderstats = LocalPlayer:FindFirstChild("leaderstats")
    if leaderstats then
        local coins = leaderstats:FindFirstChild("Coins")
        if coins then return coins.Value end
    end
    return 0
end

-- Поиск ближайшей монеты
local function getNearestCoin(rootPart)
    local container = nil
    for _, child in ipairs(workspace:GetChildren()) do
        if child:FindFirstChild("CoinContainer") then
            container = child.CoinContainer
            break
        end
    end
    if not container then return nil end

    local closestCoin = nil
    local shortestDist = math.huge

    for _, item in ipairs(container:GetChildren()) do
        local visual = item:FindFirstChild("CoinVisual")
        if visual and visual:IsA("BasePart") and visual.Transparency < 0.5 then
            local dist = (rootPart.Position - visual.Position).Magnitude
            if dist < shortestDist then
                shortestDist = dist
                closestCoin = visual
            end
        end
    end
    return closestCoin
end

-- Основной цикл
local function farmLoop()
    while isFarming do
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local humanoid = char and char:FindFirstChild("Humanoid")

        if not root or not humanoid or humanoid.Health <= 0 then
            task.wait(0.5)
            continue
        end

        -- 1. ПРОВЕРКА НА ЛИМИТ
        if getCurrentCoins() >= COIN_GOAL then
            print("[Farm] Лимит монет достигнут. Ресет.")
            isFarming = false
            humanoid.Health = 0
            break
        end

        -- 2. ИЩЕМ МОНЕТУ
        local coin = getNearestCoin(root)
        if not coin then
            task.wait(0.5)
            continue
        end

        -- 3. ТЕЛЕПОРТ "ИЗ-ПОД КАРТЫ"
        -- Сначала сохраняем текущую позицию (чтобы вернуться)
        local originalCFrame = root.CFrame
        
        -- Прячемся под карту (резко вниз)
        root.CFrame = CFrame.new(root.Position.X, root.Position.Y - UNDERMAP_OFFSET, root.Position.Z)
        task.wait(0.05) -- Ждем, пока сервер "проглотит" это

        -- Телепортируемся к монете
        root.CFrame = coin.CFrame
        task.wait(0.15) -- Ждем сбора

        -- Возвращаемся под карту (чтобы не спалиться на карте)
        root.CFrame = CFrame.new(coin.Position.X, coin.Position.Y - UNDERMAP_OFFSET, coin.Position.Z)
        task.wait(0.05)
        
        -- Ждем, чтобы не спамить
        task.wait(0.2)
    end
end

-- ==== КНОПКА ====
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "UnderMapFarm"
screenGui.ResetOnSpawn = false
screenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")

local btn = Instance.new("TextButton")
btn.Size = UDim2.new(0, 150, 0, 50)
btn.Position = UDim2.new(0, 20, 0, 260)
btn.BackgroundColor3 = Color3.fromRGB(150, 0, 150) -- Фиолетовый
btn.Text = "START UNDERMAP"
btn.TextColor3 = Color3.fromRGB(255, 255, 255)
btn.TextSize = 12
btn.Font = Enum.Font.GothamBold
btn.Parent = screenGui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 8)
corner.Parent = btn

btn.MouseButton1Click:Connect(function()
    isFarming = not isFarming
    if isFarming then
        btn.Text = "STOP"
        btn.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
        print("[Farm] Under-map farm ON. Лимит: " .. COIN_GOAL)
        farmThread = task.spawn(farmLoop)
    else
        btn.Text = "START UNDERMAP"
        btn.BackgroundColor3 = Color3.fromRGB(150, 0, 150)
        print("[Farm] Under-map farm OFF.")
        if farmThread then task.cancel(farmThread) end
    end
end)
