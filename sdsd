-- ⚠️ АВТО-ФАРМ (Монеты летят к тебе под карту)
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer
local isFarming = false
local farmThread = nil

local COIN_GOAL = 10
local UNDERMAP_Y = -500 -- Глубина, где ты будешь сидеть

-- Поиск контейнера с монетами
local function getCoinContainer()
    for _, child in ipairs(workspace:GetChildren()) do
        local container = child:FindFirstChild("CoinContainer")
        if container then return container end
    end
    return nil
end

local function farmLoop()
    while isFarming do
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local humanoid = char and char:FindFirstChild("Humanoid")

        if not root or not humanoid or humanoid.Health <= 0 then
            task.wait(1)
            continue
        end

        -- 1. Прячемся под карту (только RootPart, чтобы не сломать анимации)
        if root.Position.Y > UNDERMAP_Y + 50 then
            root.CFrame = CFrame.new(root.Position.X, UNDERMAP_Y, root.Position.Z)
            task.wait(0.5)
        end

        -- 2. Ищем монеты и тащим их к себе
        local container = getCoinContainer()
        if container then
            local movedAny = false
            for _, coin in ipairs(container:GetChildren()) do
                -- В разных версиях монета может быть Model или BasePart
                local part = coin:IsA("BasePart") and coin or coin:FindFirstChildWhichIsA("BasePart")
                if part and part.Transparency < 0.5 then
                    -- Двигаем монету к нашему RootPart
                    part.CFrame = root.CFrame
                    movedAny = true
                    task.wait(0.05) -- Небольшая пауза между монетами
                end
            end
            
            if not movedAny then
                -- Монет нет (лобби/конец раунда)
                task.wait(2)
            end
        else
            task.wait(1)
        end

        -- 3. Проверка на лимит (если смогли прочитать)
        local leaderstats = LocalPlayer:FindFirstChild("leaderstats")
        local coins = leaderstats and leaderstats:FindFirstChild("Coins")
        if coins and coins.Value >= COIN_GOAL then
            print("[Farm] Лимит достигнут. Ресет.")
            isFarming = false
            humanoid.Health = 0
            break
        end

        task.wait(0.2)
    end
end

-- ==== КНОПКА ====
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "MagnetFarm"
screenGui.ResetOnSpawn = false
screenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")

local btn = Instance.new("TextButton")
btn.Size = UDim2.new(0, 180, 0, 50)
btn.Position = UDim2.new(0, 20, 0, 260)
btn.BackgroundColor3 = Color3.fromRGB(0, 150, 200)
btn.Text = "START MAGNET FARM"
btn.TextColor3 = Color3.fromRGB(255, 255, 255)
btn.TextSize = 12
btn.Font = Enum.Font.GothamBold
btn.Parent = screenGui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 8)
corner.Parent = btn

btn.MouseButton1Click:Connect(function()
    isFarming = not isFarming
    if isFarming then
        btn.Text = "STOP"
        btn.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
        print("[Farm] Магнит включен. Монеты летят к тебе.")
        farmThread = task.spawn(farmLoop)
    else
        btn.Text = "START MAGNET FARM"
        btn.BackgroundColor3 = Color3.fromRGB(0, 150, 200)
        print("[Farm] Магнит выключен.")
        if farmThread then task.cancel(farmThread) end
    end
end)
